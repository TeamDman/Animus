{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "fixed",
          "ground"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:component",
          "component": "neovitae:spiritus_type",
          "cases": [
            {
              "when": "ruina",
              "model": {
                "type": "minecraft:model",
                "model": "animusnv:item/runic_sentient_scythe_ruina_gui"
              }
            },
            {
              "when": "nihilum",
              "model": {
                "type": "minecraft:model",
                "model": "animusnv:item/runic_sentient_scythe_nihilum_gui"
              }
            },
            {
              "when": "vindicta",
              "model": {
                "type": "minecraft:model",
                "model": "animusnv:item/runic_sentient_scythe_vindicta_gui"
              }
            },
            {
              "when": "invictus",
              "model": {
                "type": "minecraft:model",
                "model": "animusnv:item/runic_sentient_scythe_invictus_gui"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "animusnv:item/runic_sentient_scythe_gui"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "neovitae:spiritus_type",
      "cases": [
        {
          "when": "ruina",
          "model": {
            "type": "minecraft:model",
            "model": "animusnv:item/runic_sentient_scythe_ruina"
          }
        },
        {
          "when": "nihilum",
          "model": {
            "type": "minecraft:model",
            "model": "animusnv:item/runic_sentient_scythe_nihilum"
          }
        },
        {
          "when": "vindicta",
          "model": {
            "type": "minecraft:model",
            "model": "animusnv:item/runic_sentient_scythe_vindicta"
          }
        },
        {
          "when": "invictus",
          "model": {
            "type": "minecraft:model",
            "model": "animusnv:item/runic_sentient_scythe_invictus"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "animusnv:item/runic_sentient_scythe"
      }
    }
  }
}
